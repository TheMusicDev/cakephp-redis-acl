{
    "name": "themusicdev/redis-acl",
    "description": "CakePHP 5 plugin: a RedisEngine subclass that authenticates as a Redis 6 ACL user (username + password), which the stock engine cannot",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "plugin", "cache", "redis", "acl", "dsn", "sessions"],
    "homepage": "https://github.com/TheMusicDev/cakephp-redis-acl",
    "license": "MIT",
    "authors": [
        {
            "name": "TheMusicDev",
            "homepage": "https://themusicdev.llc"
        }
    ],
    "support": {
        "issues": "https://github.com/TheMusicDev/cakephp-redis-acl/issues",
        "source": "https://github.com/TheMusicDev/cakephp-redis-acl"
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2",
        "ext-redis": ">=5.3"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "captainhook/plugin-composer": "^5.3",
        "cakephp/cakephp-codesniffer": "^5.3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0",
        "ramsey/conventional-commits": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "TheMusicDev\\RedisAcl\\": "src/"
        },
        "files": [
            "config/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TheMusicDev\\RedisAcl\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check",
            "@stan"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        },
        "sort-packages": true
    }
}
